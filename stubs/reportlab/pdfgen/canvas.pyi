"""``reportlab.pdfgen.canvas`` — the drawing surface used by ``arnlabels/pdf.py``."""

from typing import IO

class Canvas:
    def __init__(
        self,
        filename: IO[bytes] | str,
        pagesize: tuple[float, float] | None = ...,
        bottomup: int = ...,
        pageCompression: int | None = ...,
        invariant: int | None = ...,
        verbosity: int = ...,
        encrypt: object | None = ...,
    ) -> None: ...
    def setFont(
        self, psfontname: str, size: float, leading: float | None = ...
    ) -> None: ...
    def stringWidth(
        self, text: str, fontName: str | None = ..., fontSize: float | None = ...
    ) -> float: ...
    def drawString(self, x: float, y: float, text: str) -> None: ...
    def drawCentredString(self, x: float, y: float, text: str) -> None: ...
    def drawRightString(self, x: float, y: float, text: str) -> None: ...
    def showPage(self) -> None: ...
    def save(self) -> None: ...
